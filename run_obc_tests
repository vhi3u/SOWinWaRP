#!/bin/bash
#
# Short GPU tests of open boundary condition configurations.
#
#     ./run_obc_tests                             # every configuration, 90 days
#     ./run_obc_tests clamped radiation gradient  # only these
#     ./run_obc_tests --days 10 --list            # show what would be submitted
#
# Each configuration is one job at the production resolution, writing to
# obc_tests/NAME_DAYSd_surface.nc and the matching midlon and boundary diagnostics.
#
# 90 days is the default because 10 is not long enough to tell these apart: the western
# boundary jet builds over a ~20-day cycle, and at 10 days every configuration is still in
# its spin-up transient. Use --days 10 only to check that a configuration runs at all.
# Compare them afterwards with:
#
#     julia --project=. tools/compare_obc_tests.jl
#     ./run_animate_simulation obc_tests/NAME
#
# The variants are generated by rewriting the `const` lines at the top of src/model.jl
# into obc_tests/model_NAME.jl, so src/model.jl itself stays a plain literal
# configuration with no test knobs in it.

set -euo pipefail

DAYS=90
LIST_ONLY=0
SELECTED=()

# name              tangential BC                      normal-flow scheme        barotropic
#
# `barotropic` adds Flather conditions on the depth-integrated transport U and V. With it
# false, the split-explicit corrector holds the net transport through every face at zero
# regardless of the other two columns, so the *_bt pairs below are the A/B that matters:
# compare clamped against clamped_bt before reading anything into the rest.
CONFIGS=(
    "clamped|clamped|PerturbationAdvection|false"
    "clamped_bt|clamped|PerturbationAdvection|true"
    "oblique|oblique|ObliqueRadiation|false"
    "oblique_bt|oblique|ObliqueRadiation|true"
    "pa_bt|gradient|PerturbationAdvection|true"
    "oblique_normal_bt|radiation|ObliqueRadiation|true"
    "gradient|gradient|PerturbationAdvection|false"
    "radiation|radiation|PerturbationAdvection|false"
    "radiation_bv|radiation_boundary_velocity|PerturbationAdvection|false"
    "pa_gravity|perturbation_advection_gravity|PerturbationAdvection|false"
    "pa_plain|perturbation_advection|PerturbationAdvection|false"
    "oblique_bv|oblique_boundary_velocity|ObliqueRadiation|false"
    "oblique_normal|radiation|ObliqueRadiation|false"
    "radiation_both|radiation|NormalRadiation|false"
    "gradient_radnormal|gradient|NormalRadiation|false"
)

while [ $# -gt 0 ]; do
    case "$1" in
        --days) DAYS="$2"; shift 2 ;;
        --list) LIST_ONLY=1; shift ;;
        -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
        -*) echo "unknown option: $1" >&2; exit 1 ;;
        *) SELECTED+=("$1"); shift ;;
    esac
done

# ~30 simulated days per wall hour once running, plus an hour for setup and the first
# boundary-condition build.
WALLTIME=$(printf '%02d:00:00' $(( 1 + (DAYS + 24) / 25 )))

mkdir -p obc_tests logs
echo "Wall time per job: $WALLTIME for $DAYS simulated days"


for entry in "${CONFIGS[@]}"; do
    IFS='|' read -r name tangential normal barotropic <<< "$entry"

    # skip anything not asked for, when a subset was given
    if [ ${#SELECTED[@]} -gt 0 ]; then
        wanted=0
        for want in "${SELECTED[@]}"; do [ "$want" = "$name" ] && wanted=1; done
        [ $wanted -eq 1 ] || continue
    fi

    run_name="${name}_${DAYS}d"
    variant="obc_tests/model_${run_name}.jl"

    # Rewrite the configuration literals. `include("setup_bsose.jl")` is resolved relative
    # to the including file, so it has to be redirected now that the variant lives in
    # obc_tests/ rather than src/.
    sed -e "s|^const RUN_NAME = .*|const RUN_NAME = \"obc_tests/${run_name}\"|" \
        -e "s|^const TANGENTIAL_BC = .*|const TANGENTIAL_BC = :${tangential}|" \
        -e "s|^const OBC_SCHEME = .*|const OBC_SCHEME = \"${normal}\"|" \
        -e "s|^const BAROTROPIC_OBC = .*|const BAROTROPIC_OBC = ${barotropic}|" \
        -e "s|^end_date = .*|end_date = start_date + Day(${DAYS})|" \
        -e "s|^include(\"setup_bsose.jl\")|include(joinpath(@__DIR__, \"..\", \"src\", \"setup_bsose.jl\"))|" \
        src/model.jl > "$variant"

    # Fail loudly rather than silently testing the wrong thing
    grep -q "const TANGENTIAL_BC = :${tangential}\$" "$variant" || {
        echo "error: could not set TANGENTIAL_BC in $variant" >&2; exit 1; }
    grep -q "^end_date = start_date + Day(${DAYS})\$" "$variant" || {
        echo "error: could not set end_date in $variant" >&2; exit 1; }
    grep -q "^const BAROTROPIC_OBC = ${barotropic}\$" "$variant" || {
        echo "error: could not set BAROTROPIC_OBC in $variant" >&2; exit 1; }

    printf '%-20s tangential=%-32s normal=%-22s barotropic=%-5s %3sd -> %s\n' \
        "$name" "$tangential" "$normal" "$barotropic" "$DAYS" "$variant"
    [ $LIST_ONLY -eq 1 ] && continue

    sbatch --job-name="obc_${run_name}" <<EOF
#!/bin/bash
#SBATCH --account=gts-ldove6-paid
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=${WALLTIME}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:V100:1
#SBATCH --mem-per-gpu=32G

set -euo pipefail

echo "=========================================================="
echo " Config     : ${run_name}"
echo " Tangential : ${tangential}"
echo " Normal     : ${normal}"
echo " Barotropic : ${barotropic}"
echo " Days       : ${DAYS}"
echo " Node       : \$(hostname)"
echo " Start Time : \$(date)"
echo "=========================================================="

module purge
module load julia/1.12.5
unset LD_LIBRARY_PATH

# A configuration that diverges does so in the first minute, so a failure here is a
# result, not an error: record it and let the other configurations carry on.
if julia --project=. "${variant}"; then
    echo "RESULT ${run_name}: completed ${DAYS} days"
else
    echo "RESULT ${run_name}: FAILED (exit \$?) — see the log above for where it diverged"
fi

echo " Finished   : \$(date)"
EOF
done

if [ $LIST_ONLY -eq 0 ]; then
    echo
    echo "Submitted. Watch with: squeue -u \$USER"
    echo "Then compare with:     julia --project=. tools/compare_obc_tests.jl"
fi
