#!/bin/bash
#
# Concurrent GPU tests of open boundary configurations. One SLURM job per configuration.
#
#     ./run_obc_tests --list                      # show what would be submitted, change nothing
#     ./run_obc_tests                             # the default set
#     ./run_obc_tests flat_upper base             # only these
#     ./run_obc_tests --days 5 --set simplify     # a named group, 5 days
#
# Each configuration is generated by rewriting the `const` lines of src/model.jl into
# obc_tests/model_NAME.jl, so src/model.jl stays a plain literal configuration with no test
# knobs in it, and the variants are gitignored.
#
# ---------------------------------------------------------------------------------------------
# WHY THIS WAS REWRITTEN (2026-10-25)
#
# The previous version matched on `^const OBC_SCHEME = `, `^const BAROTROPIC_OBC = ` and
# `^end_date = `. The configuration block was realigned since, so three of its five patterns
# stopped matching and it would `exit 1` on the first configuration. It failed safely rather
# than testing the wrong thing -- its verification greps are why -- but it had stopped working.
#
# So: overrides are now a generic `NAME=VALUE` list rather than four positional columns,
# `set_const` tolerates any alignment via `^const NAME *=`, and EVERY override is verified
# after it is applied. Adding a knob no longer means adding a column.
#
# Also: every result from the previous version is void. It predates the barotropic boundary
# condition existing at all (2026-10-03) and the west/east exterior-profile index bug
# (2026-10-23). See sections 4.6.2 and 4.5 of Model Architecture.md.
# ---------------------------------------------------------------------------------------------

set -euo pipefail

DAYS=20
LIST_ONLY=0
SET_NAME="default"
SELECTED=()

# ---------------------------------------------------------------------------------------------
# Configurations: NAME | CONST=VALUE;CONST=VALUE;...
#
# An empty override list means "src/model.jl exactly as committed", which is the reference every
# other arm is measured against. Values are substituted literally, so Julia syntax -- quotes,
# colons, constructor calls -- must be written the way the file needs it.
# ---------------------------------------------------------------------------------------------

# The boundary-scheme matrix. BAROTROPIC_OBC is NOT a dimension here: with it false the
# split-explicit corrector drives the net transport through every face to zero whatever the 3-D
# field carries, so those arms measure nothing. `no_bt` is kept as a single control to show that.
CONFIGS_schemes=(
    "base|"
    "tang_radiation|TANGENTIAL_BC=:radiation"
    "tang_clamped|TANGENTIAL_BC=:clamped"
    "normal_pa|OBC_SCHEME=\"PerturbationAdvection\""
    "normal_clamped|OBC_SCHEME=\"clamped\""
    "bt_flather|BAROTROPIC_SCHEME=:flather"
    "ext_ssh|EXTERIOR_SSH=true"
    "no_bt|BAROTROPIC_OBC=false"
)

# The simplification ladder. Each step removes one source of difficulty, so the first arm that
# behaves tells you which ingredient the boundary machinery cannot cope with. Read it bottom-up:
# if `flat_upper` is clean and `flat_deep` is not, depth is the problem; if `flat_deep` is clean
# and `base` is not, depth VARIATION is; and so on.
#
# `flat_upper` is the only self-consistent one. B-SOSE has valid data in the top ~1000 m of every
# wet column, so its prescribed transport is real data rather than inpainted filler and the
# volume budget should still close. `flat_deep` flattens to 3000 m, which DEEPENS every column
# shallower than that and prescribes inpainted values below their real floor -- it is a control
# for `flat_upper`, not a physical case.
CONFIGS_simplify=(
    "base|"
    "flat_deep|FLAT_BOTTOM_DEPTH=3000"
    "flat_upper|FLAT_BOTTOM_DEPTH=1000;Z_EXTENT=1200;DZ_SURFACE=10;DZ_BOTTOM=50"
    "coarse_z|DZ_SURFACE=20;DZ_BOTTOM=400"
    "flat_upper_radiation|FLAT_BOTTOM_DEPTH=1000;Z_EXTENT=1200;DZ_SURFACE=10;DZ_BOTTOM=50;TANGENTIAL_BC=:radiation"
)

# Sponge strength. Held back on 2026-10-25, kept here because the only sponge ever run was 60x
# weaker than NestingValidation's canary (30 days against its `rate = 1/12hours`), so no earlier
# sponge arm tested anything. See section 4.6.3.
CONFIGS_sponge=(
    "base|"
    "sponge_12h|SPONGE_LAYERS=true;SPONGE_TIMESCALE=12hours"
    "sponge_1d|SPONGE_LAYERS=true;SPONGE_TIMESCALE=1days"
    "sponge_30d|SPONGE_LAYERS=true;SPONGE_TIMESCALE=30days"
)

while [ $# -gt 0 ]; do
    case "$1" in
        --days) DAYS="$2"; shift 2 ;;
        --set)  SET_NAME="$2"; shift 2 ;;
        --list) LIST_ONLY=1; shift ;;
        -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
        -*) echo "unknown option: $1" >&2; exit 1 ;;
        *) SELECTED+=("$1"); shift ;;
    esac
done

case "$SET_NAME" in
    default|schemes) CONFIGS=("${CONFIGS_schemes[@]}") ;;
    simplify)        CONFIGS=("${CONFIGS_simplify[@]}") ;;
    sponge)          CONFIGS=("${CONFIGS_sponge[@]}") ;;
    all)
        # `base` appears in every group. Without deduplication `--set all` would submit it three
        # times under one run_name, and the three jobs would overwrite each other's output.
        CONFIGS=()
        seen=""
        for e in "${CONFIGS_schemes[@]}" "${CONFIGS_simplify[@]}" "${CONFIGS_sponge[@]}"; do
            case " $seen " in *" ${e%%|*} "*) continue ;; esac
            seen="$seen ${e%%|*}"
            CONFIGS+=("$e")
        done ;;
    *) echo "unknown --set: $SET_NAME (schemes | simplify | sponge | all)" >&2; exit 1 ;;
esac

# ~30 simulated days per wall hour at production resolution, plus an hour for setup and the
# first boundary-condition build. The simplified arms are much faster but ask for the same.
WALLTIME=$(printf '%02d:00:00' $(( 1 + (DAYS + 24) / 25 )))

mkdir -p obc_tests logs
echo "set=$SET_NAME  days=$DAYS  walltime=$WALLTIME"
echo

# Rewrite one `const` in a generated variant, tolerating any alignment, and VERIFY it.
# A silent miss here means a job runs for an hour testing the committed configuration under
# another name, which is worse than not running it.
set_const() {
    local name="$1" value="$2" file="$3"
    grep -qE "^const ${name} *=" "$file" || {
        echo "error: src/model.jl has no 'const ${name} =' to rewrite" >&2; exit 1; }
    sed -i.bak -E "s|^const ${name} *=.*|const ${name} = ${value}|" "$file" && rm -f "${file}.bak"
    grep -qxF "const ${name} = ${value}" "$file" || {
        echo "error: failed to set ${name} = ${value} in ${file}" >&2; exit 1; }
}

for entry in "${CONFIGS[@]}"; do
    IFS='|' read -r name overrides <<< "$entry"

    if [ ${#SELECTED[@]} -gt 0 ]; then
        wanted=0
        for want in "${SELECTED[@]}"; do [ "$want" = "$name" ] && wanted=1; done
        [ $wanted -eq 1 ] || continue
    fi

    run_name="${name}_${DAYS}d"
    variant="obc_tests/model_${run_name}.jl"

    # `include("setup_bsose.jl")` resolves relative to the including file, so it has to be
    # redirected now that the variant lives in obc_tests/ rather than src/.
    sed -e "s|^include(\"setup_bsose.jl\")|include(joinpath(@__DIR__, \"..\", \"src\", \"setup_bsose.jl\"))|" \
        src/model.jl > "$variant"
    grep -q 'include(joinpath(@__DIR__, "..", "src", "setup_bsose.jl"))' "$variant" || {
        echo "error: could not redirect the setup_bsose.jl include in $variant" >&2; exit 1; }

    set_const RUN_NAME "\"obc_tests/${run_name}\"" "$variant"
    set_const END_DATE "START_DATE + Day(${DAYS})" "$variant"

    if [ -n "$overrides" ]; then
        IFS=';' read -ra pairs <<< "$overrides"
        for pair in "${pairs[@]}"; do
            set_const "${pair%%=*}" "${pair#*=}" "$variant"
        done
    fi

    printf '%-22s %3sd  %s\n' "$name" "$DAYS" "${overrides:-<src/model.jl as committed>}"
    [ $LIST_ONLY -eq 1 ] && continue

    sbatch --job-name="obc_${run_name}" <<EOF
#!/bin/bash
#SBATCH --account=gts-ldove6-paid
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=${WALLTIME}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:V100:1
#SBATCH --mem-per-gpu=32G

set -uo pipefail

echo "=========================================================="
echo " Config    : ${run_name}"
echo " Overrides : ${overrides:-<src/model.jl as committed>}"
echo " Days      : ${DAYS}"
echo " Node      : \$(hostname)"
echo " Start     : \$(date)"
echo "=========================================================="

module purge
module load julia/1.12.5
unset LD_LIBRARY_PATH

export JULIA_CPU_TARGET=\${JULIA_CPU_TARGET:-generic}
export JULIA_PKGIMAGES=\${JULIA_PKGIMAGES:-no}

# A configuration that diverges does so in the first minutes, so a failure is a RESULT, not an
# error: record it and let the other configurations carry on. stdbuf keeps the Julia output
# interleaved with these echoes instead of arriving in one block at the end.
if stdbuf -o0 -e0 julia --project=. "${variant}"; then
    echo "RESULT ${run_name}: completed ${DAYS} days"
else
    echo "RESULT ${run_name}: FAILED (exit \$?) -- see above for where it diverged"
fi

echo " Finished  : \$(date)"
EOF
done

if [ $LIST_ONLY -eq 0 ]; then
    echo
    echo "Submitted. Watch with:  squeue -u \$USER"
    echo "Collect failures:       grep -h '^RESULT' logs/obc_*.out"
    echo "Compare:                julia --project=. tools/compare_obc_tests.jl"
fi
