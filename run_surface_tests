#!/bin/bash
#
# Surface-forcing ladder. One SLURM job per configuration, all on the committed boundary
# conditions -- this does NOT vary the open boundaries, only what the surface does.
#
#     ./run_surface_tests --list          # show what would be submitted, change nothing
#     ./run_surface_tests                 # all five arms
#     ./run_surface_tests none wind       # only these
#     ./run_surface_tests --no-analysis   # model only, skip the per-run diagnostics
#     ./run_surface_tests --no-summary    # skip the cross-arm job that runs after them all
#
# AFTER EACH ARM COMPLETES it runs `tools/compare_bsose.jl` on its own output, so each job leaves
# behind that arm's monthly surface differences against B-SOSE, its mixed-layer and Winter Water
# tables, the upper-200 m vertical structure and the drift table -- without waiting for the other
# six. Figures land in surface_tests/figs, prefixed by arm name. The analysis is guarded: if it
# fails, the RESULT line for the model run still stands.
#
# THEN, once every arm has terminated, a final CPU-only job runs
# `tools/compare_surface_tests.jl`, which needs all of them present and puts them on shared axes.
# It is submitted with `--dependency=afterany`, not `afterok`: an arm that diverges should not
# stop you seeing the ones that did not, and the comparison script already warns and skips any
# arm whose output is missing. Nothing in this sweep has to be run by hand.
#
# Each arm is generated by rewriting the `const` lines of src/model.jl into
# surface_tests/model_NAME.jl, so src/model.jl stays a plain literal configuration.
#
# ---------------------------------------------------------------------------------------------
# THE LADDER. Each arm adds exactly ONE forcing term to the one above it, so the first arm that
# reproduces a feature tells you which term is responsible for it. Read it top-down.
#
#     none         nothing at the surface at all. Boundaries and sponge only. This is the
#                  control: whatever drift it shows is the boundaries, not the forcing.
#     wind         + BSOSE oceTAUX / oceTAUY (monthly). Momentum only, no buoyancy.
#     wind_tsflux  + BSOSE TFLUX and SFLUX. Heat and salt, with ALL of TFLUX deposited in the
#                  top cell and SFLUX carrying brine only.
#     wind_fw      + oceFWflx as a virtual salt flux. This is the P-E / melt dilution, which
#                  SFLUX does not contain.
#     wind_fw_sw   + the oceQsw split, so sunlight penetrates instead of landing in the top
#                  cell. This arm is src/model.jl as committed.
#
# AND TWO ARMS OFF THE LADDER:
#
#     wind_fw_sw_freeze
#                  the committed configuration PLUS a freezing buffer: wherever the ocean sits
#                  below the liquidus, T is relaxed back up to it over 3 days (Losch et al. 2010
#                  sec 2.2). One-sided -- it never cools, because the melting side is already in
#                  TFLUX. This is the minimal sea-ice representation, not a sea-ice model: no
#                  ice, no albedo, no drift, no freshwater capacitor. A real one needs ClimaSeaIce
#                  plus an atmosphere, because B-SOSE's fluxes are POST-ice.
#
#                  Measured 2026-10-28: B-SOSE's own ice-ocean heat exchange is already inside
#                  what we apply (oceFreez is identically zero, TFLUX - oceQnet is 0.2%), so this
#                  arm adds no missing heat. What it restores is the STATE DEPENDENCE that a
#                  prescribed flux cannot have. FREEZING_DIAGNOSTIC is on in EVERY arm, so the
#                  control arms report whether sub-liquidus water is being made at all.
#
#     wind_qsw_fw  the OTHER half of the decomposition -- oceQsw and oceFWflx with TFLUX and
#                  SFLUX excluded entirely. TOTAL_HEAT_FLUX=false zeroes the top heat flux so
#                  oceQsw (through the penetrating radiation) is the only heat input, and
#                  BRINE_FLUX=false zeroes SFLUX so -S*oceFWflx is the only salt forcing.
#
#                  READ THIS BEFORE INTERPRETING IT. oceQsw is a ONE-SIDED heat source: it
#                  averages about +120 W/m2 over this window at 55-60S against TFLUX's near-zero
#                  annual mean, which is roughly +6 degC in the upper 100 m over 8 months and
#                  worse at the surface, since TwoColorRadiation deposits most of it in the top
#                  tens of metres. This arm measures the SIZE of each half of the split; it is
#                  not a physical configuration and its T field is not meant to resemble B-SOSE.
#                  It may also slow down or stop early if the warming trips the CFL limiter.
#
# SPONGE. Every arm runs SPONGE_TIMESCALE = 12 hours, NestingValidation's canary value, rather
# than the 6 h in src/model.jl. Section 1 of compare_bsose.jl measured a clean knee at 18 cells
# with 1 day, so the sponge was already working; 12 h is the published analogue and keeps one
# variable fixed across the ladder.
#
# NO PREP JOBS. Every arm shares the production vertical grid, so they all hit the same
# bathymetry cache key and there is no race to write it -- unlike run_obc_tests, where arms with
# different Nz needed one prep job per grid. If that cache is ever missing, build it once by
# hand with `julia --project=. tools/prebuild_bathymetry.jl` before submitting.
# ---------------------------------------------------------------------------------------------

set -euo pipefail

START="2014-06-01"
ANALYSE=1
SUMMARY=1
MONTHS="6,7,8,9,10,11,12,1"
STOP="2015-02-01"
# MEASURED: 8M_bsose_fwf, the same window and grid, took 2.025 hours. 4 h is ~2x headroom.
# Asking for more than you need only costs queue priority -- but note there is NO restart path
# (model.jl has no `pickup=`), so an arm that hits the wall loses the whole run.
WALLTIME="04:00:00"
LIST_ONLY=0
WALLTIME_EXPLICIT=0
SELECTED=()

CONFIGS=(
    "none|WINDS=false;SURFACE_FLUXES=false;PENETRATING_SHORTWAVE=false;FRESHWATER_FLUX=false"
    "wind|WINDS=true;SURFACE_FLUXES=false;PENETRATING_SHORTWAVE=false;FRESHWATER_FLUX=false"
    "wind_tsflux|WINDS=true;SURFACE_FLUXES=true;TOTAL_HEAT_FLUX=true;BRINE_FLUX=true;PENETRATING_SHORTWAVE=false;FRESHWATER_FLUX=false"
    "wind_fw|WINDS=true;SURFACE_FLUXES=true;TOTAL_HEAT_FLUX=true;BRINE_FLUX=true;PENETRATING_SHORTWAVE=false;FRESHWATER_FLUX=true"
    "wind_fw_sw|WINDS=true;SURFACE_FLUXES=true;TOTAL_HEAT_FLUX=true;BRINE_FLUX=true;PENETRATING_SHORTWAVE=true;FRESHWATER_FLUX=true"
    "wind_qsw_fw|WINDS=true;SURFACE_FLUXES=true;TOTAL_HEAT_FLUX=false;BRINE_FLUX=false;SHORTWAVE_AS_HEAT_FLUX=true;PENETRATING_SHORTWAVE=false;FRESHWATER_FLUX=true|08:00:00"
    "wind_fw_sw_freeze|WINDS=true;SURFACE_FLUXES=true;TOTAL_HEAT_FLUX=true;BRINE_FLUX=true;PENETRATING_SHORTWAVE=true;FRESHWATER_FLUX=true;FREEZING_RELAXATION=true"
)

# Applied to every arm, on top of its own overrides.
COMMON="SPONGE_LAYERS=true;SPONGE_TIMESCALE=12hours"

while [ $# -gt 0 ]; do
    case "$1" in
        --walltime) WALLTIME="$2"; WALLTIME_EXPLICIT=1; shift 2 ;;
        --start)    START="$2"; shift 2 ;;
        --stop)     STOP="$2"; shift 2 ;;
        --list)     LIST_ONLY=1; shift ;;
        --no-analysis) ANALYSE=0; shift ;;
        --no-summary)  SUMMARY=0; shift ;;
        -h|--help)  sed -n '2,40p' "$0"; exit 0 ;;
        -*) echo "unknown option: $1" >&2; exit 1 ;;
        *) SELECTED+=("$1"); shift ;;
    esac
done

mkdir -p surface_tests logs

# GATE. A global used before it is defined parses fine, lints fine, and dies with UndefVarError
# at job start -- after the queue wait, the module load and the bathymetry build. Two submitted
# jobs have been lost that way. One second here, hours there.
if command -v julia >/dev/null 2>&1; then
    julia tools/check_forward_refs.jl src/model.jl >/dev/null || {
        echo "error: src/model.jl uses a global before it is defined; not submitting." >&2
        julia tools/check_forward_refs.jl src/model.jl >&2
        exit 1
    }
fi

echo "window=$START to $STOP  walltime=$WALLTIME (8M_bsose_fwf measured 2.025 h)"
echo "common to every arm: $COMMON"
echo

# Submit a job script that has been written to disk, after checking it parses. Same reasoning as
# run_obc_tests: a bare heredoc into sbatch has silently mangled scripts here before, and the
# evidence vanished with the job.
submit_job() {
    local job="$1"; shift
    bash -n "$job" || { echo "error: generated job script $job is malformed; not submitting" >&2; exit 1; }
    sbatch --parsable "$@" "$job"
}

# Rewrite one `const` in a generated variant, tolerating any alignment, and VERIFY it. A silent
# miss means a job runs for hours testing the committed configuration under another name.
set_const() {
    local name="$1" value="$2" file="$3"
    grep -qE "^const ${name} *=" "$file" || {
        echo "error: src/model.jl has no 'const ${name} =' to rewrite" >&2; exit 1; }
    sed -i.bak -E "s|^const ${name} *=.*|const ${name} = ${value}|" "$file" && rm -f "${file}.bak"
    grep -qxF "const ${name} = ${value}" "$file" || {
        echo "error: failed to set ${name} = ${value} in ${file}" >&2; exit 1; }
}

for entry in "${CONFIGS[@]}"; do
    # third field is an optional per-arm walltime; --walltime overrides every arm.
    IFS='|' read -r name overrides arm_walltime <<< "$entry"
    walltime="${arm_walltime:-$WALLTIME}"
    [ "$WALLTIME_EXPLICIT" = "1" ] && walltime="$WALLTIME"

    if [ ${#SELECTED[@]} -gt 0 ]; then
        wanted=0
        for want in "${SELECTED[@]}"; do [ "$want" = "$name" ] && wanted=1; done
        [ $wanted -eq 1 ] || continue
    fi

    variant="surface_tests/model_${name}.jl"

    # `include("setup_bsose.jl")` resolves relative to the including file, so it has to be
    # redirected now that the variant lives in surface_tests/ rather than src/.
    sed -e "s|^include(\"setup_bsose.jl\")|include(joinpath(@__DIR__, \"..\", \"src\", \"setup_bsose.jl\"))|" \
        src/model.jl > "$variant"
    grep -q 'include(joinpath(@__DIR__, "..", "src", "setup_bsose.jl"))' "$variant" || {
        echo "error: could not redirect the setup_bsose.jl include in $variant" >&2; exit 1; }

    set_const RUN_NAME   "\"surface_tests/${name}\"" "$variant"
    set_const START_DATE "DateTime(\"${START}\")"    "$variant"
    set_const END_DATE   "DateTime(\"${STOP}\")"     "$variant"

    IFS=';' read -ra pairs <<< "${overrides};${COMMON}"
    for pair in "${pairs[@]}"; do
        [ -n "$pair" ] || continue
        set_const "${pair%%=*}" "${pair#*=}" "$variant"
    done

    printf '%-14s %-8s %s\n' "$name" "$walltime" "$overrides"

    job="surface_tests/job_${name}.sh"
    cat > "$job" <<EOF
#!/bin/bash
#SBATCH --account=gts-ldove6-paid
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=${walltime}
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:V100:1
#SBATCH --mem-per-gpu=32G

set -uo pipefail

echo "=========================================================="
echo " Config    : ${name}"
echo " Window    : ${START} to ${STOP}"
echo " Node      : \$(hostname)"
echo " Start     : \$(date)"
echo "=========================================================="

module purge
module load julia/1.12.5
unset LD_LIBRARY_PATH
export JULIA_CPU_TARGET=\${JULIA_CPU_TARGET:-generic}
export JULIA_PKGIMAGES=\${JULIA_PKGIMAGES:-no}

if stdbuf -o0 -e0 julia --project=. ${variant}; then
    echo "RESULT ${name}: completed ${START} to ${STOP}"

    if [ "${ANALYSE}" = "1" ]; then
        echo "=========================================================="
        echo " Diagnostics for ${name} against B-SOSE"
        echo "=========================================================="
        export DIR=surface_tests
        export OUTDIR=surface_tests/figs
        export MONTHS=${MONTHS}
        julia --project=. tools/compare_bsose.jl "${name}" 8M S6 || echo "NOTE ${name}: diagnostics failed; the RUN itself completed (see RESULT above)"
    fi
else
    echo "RESULT ${name}: FAILED exit \$? -- see above for where it diverged"
fi

echo " Finished  : \$(date)"
EOF

    if [ $LIST_ONLY -eq 1 ]; then
        bash -n "$job" || { echo "error: $job is malformed" >&2; exit 1; }
        continue
    fi

    jid=$(submit_job "$job" --job-name="sfc_${name}")
    JIDS+=("$jid")
    SUBMITTED+=("$name")
done

# ---- one more job, after every arm has terminated ----
if [ $LIST_ONLY -eq 0 ] && [ "$SUMMARY" = "1" ] && [ ${#JIDS[@]} -gt 0 ]; then
    dep=$(IFS=:; echo "${JIDS[*]}")
    runs=$(IFS=,; echo "${SUBMITTED[*]}")
    sjob="surface_tests/job_summary.sh"
    cat > "$sjob" <<EOF
#!/bin/bash
#SBATCH --account=gts-ldove6-paid
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G

set -uo pipefail

echo "=========================================================="
echo " Cross-arm comparison: ${runs}"
echo " Start     : \$(date)"
echo "=========================================================="

module purge
module load julia/1.12.5
unset LD_LIBRARY_PATH
export JULIA_CPU_TARGET=\${JULIA_CPU_TARGET:-generic}
export JULIA_PKGIMAGES=\${JULIA_PKGIMAGES:-no}

export DIR=surface_tests
export OUTDIR=surface_tests/figs
export RUNS=${runs}
export MONTHS=${MONTHS}
julia --project=. tools/compare_surface_tests.jl

echo " Finished  : \$(date)"
EOF
    sid=$(submit_job "$sjob" --job-name="sfc_summary" --dependency=afterany:${dep})
    echo
    echo "summary job $sid runs tools/compare_surface_tests.jl after all ${#JIDS[@]} arms terminate"
fi

if [ $LIST_ONLY -eq 0 ]; then
    echo
    echo "Submitted. Watch with:  squeue -u \$USER"
    echo "Collect failures:       grep -h '^RESULT' logs/sfc_*.out"
    echo "Figures land in:        surface_tests/figs"
fi
